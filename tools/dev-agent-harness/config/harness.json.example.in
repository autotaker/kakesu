{
  "version": 1,
  "paths": {
    "config_dir": "@sysconfdir@/dev-agent-harness",
    "state_dir": "@localstatedir@/lib/dev-agent-harness",
    "runtime_dir": "@runstatedir@/dev-agent-harness"
  },
  "users": {
    "agent": "@agent_user@",
    "runtime": "@runtime_user@",
    "broker": "@broker_user@"
  },
  "identity": {
    "workspace_id": "workspace-1"
  },
  "network": {
    "default": "deny"
  },
  "egress": {
    "github_repositories": ["octo/repo"],
    "openai_models": ["gpt-4o-mini"]
  }
}
