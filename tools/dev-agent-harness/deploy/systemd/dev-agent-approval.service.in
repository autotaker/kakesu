[Unit]
Description=Development Agent Harness approval service
After=network.target dev-agent-broker.service
Requires=dev-agent-broker.service

[Service]
Type=simple
User=@broker_user@
Group=@broker_user@
ExecStart=@harness_libexecdir@/dev-agent-harness/dev-agent-approval
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@localstatedir@/lib/dev-agent-harness @runstatedir@/dev-agent-harness
Restart=on-failure

[Install]
WantedBy=multi-user.target
