[Unit]
Description=Development Agent Harness egress proxy
After=network.target dev-agent-egress.socket
Requires=dev-agent-egress.socket

[Service]
Type=simple
Sockets=dev-agent-egress.socket
User=@broker_user@
Group=@broker_user@
ExecStart=@harness_libexecdir@/dev-agent-harness/dev-agent-egress serve --config @sysconfdir@/dev-agent-harness/harness.json
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@runstatedir@/dev-agent-harness
Restart=on-failure

[Install]
WantedBy=multi-user.target
